  {
    "click": "[data-map-mode=\"details\"]",
    "eval": "(()=>{const ids=[...document.querySelectorAll('.skill-node[data-node]')].map(e=>e.dataset.node),expected=MATREE.detailNodes.filter(n=>n.category==='tal'&&n.yearViews.includes('7'));if(ids.length!==expected.length||ids.some(id=>!expected.some(n=>n.id===id)))throw Error('Year and area filter disagree');return {year:7,area:'tal',skills:ids.length};})()"
  },
  {
    "eval": "document.querySelector('#map-zoom').value='160';document.querySelector('#map-zoom').dispatchEvent(new Event('input'));document.querySelector('#map-scroll').scrollIntoView({block:'start'});void 0"
  },
  {
    "drag": {
      "selector": "#map-scroll",
      "dx": -120,
      "dy": -180
    },
    "eval": "(()=>{const m=document.querySelector('#map-scroll');if(m.scrollTop<100||document.querySelector('#skill-dialog').open)throw Error('Panning failed');return {left:m.scrollLeft,top:m.scrollTop};})()",
    "screenshot": "live-r1-map-desktop.png"
  },
  {
    "eval": "document.querySelector('#map-scroll').addEventListener('click',()=>{const m=document.querySelector('#map-scroll');window.liveMapOrigin={left:m.scrollLeft,top:m.scrollTop,page:scrollY};},{capture:true,once:true});void 0"
  },
  {
    "click": ".skill-node[data-node]"
  },
  {
    "key": "Escape",
    "eval": "await new Promise(r=>setTimeout(r,150));if(document.querySelector('#skill-dialog').open||document.querySelector('#map-scroll').scrollLeft!==liveMapOrigin.left||document.querySelector('#map-scroll').scrollTop!==liveMapOrigin.top||scrollY!==liveMapOrigin.page)throw Error('Map position lost after dialog');"
  },
