    "click": "#next-question"
  },
  {
    "eval": "document.querySelector('#answer').value=String(MATREE_APP.profile().quiz.questions[2].answer).replace('.',',');void 0"
  },
  {
    "click": "#answer-form .primary-button"
  },
  {
    "click": "#next-question",
    "eval": "if(MATREE_APP.latest('f-decimal').score!==3||MATREE_APP.profile().quiz)throw Error('Manual 3/3 not stored');",
